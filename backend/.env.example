# ================================================================
# ZERITH Backend — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# NUNCA commite o .env — ele está no .gitignore
# ================================================================

# Perfil Spring ativo (dev ou prod)
SPRING_PROFILES_ACTIVE=dev

# Banco de dados (Neon PostgreSQL) — variáveis separadas
DB_HOST=ep-round-scene-acmnl36g.sa-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=sua_senha_aqui

# Porta (opcional — padrão 8080)
PORT=8080

# CORS — origens permitidas (separadas por vírgula)
# Em prod, configurar no servidor com o domínio do frontend
ZERITH_CORS_ALLOWED_ORIGINS=https://app.zerithfrotas.tech

# JWT
JWT_SECRET=sua_chave_secreta_minimo_256_bits
JWT_EXPIRATION_MS=86400000
