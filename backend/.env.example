# Perfil Spring ativo (dev ou prod)
SPRING_PROFILES_ACTIVE=dev

# Connection string do Neon (PostgreSQL)
# Formato: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=postgresql://neondb_owner:SUA_SENHA@ep-round-scene-acmnl36g.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Porta (opcional — padrão 8080)
PORT=8080

# JWT (fase 2 — autenticação)
# JWT_SECRET=sua_chave_secreta_minimo_256_bits
# JWT_EXPIRATION_MS=86400000
