# Variáveis de ambiente do ZerithDash
# Copie este arquivo para .env e preencha com os valores reais
# NUNCA commite o arquivo .env — ele está no .gitignore

# -------------------------------------------------------
# ZerithCore — API REST (Spring Boot)
# -------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api/v1

# -------------------------------------------------------
# ZerithBrain — API de ML (FastAPI)
# -------------------------------------------------------
VITE_ML_API_URL=http://localhost:8000

# -------------------------------------------------------
# Ambiente
# -------------------------------------------------------
VITE_ENV=development
